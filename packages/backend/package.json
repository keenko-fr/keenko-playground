{
  "name": "@keenko-playground/backend",
  "private": true,
  "type": "module",
  "exports": {},
  "scripts": {
    "codegen": "confect codegen",
    "dev": "bun run --parallel \"dev:*\"",
    "dev:confect": "confect dev",
    "dev:convex": "convex dev"
  },
  "dependencies": {
    "@confect/core": "10.0.0-next.21",
    "@confect/server": "10.0.0-next.21",
    "convex": "1.45.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@confect/cli": "10.0.0-next.21",
    "@edge-runtime/vm": "5.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "convex-test": "0.0.56",
    "typescript": "6.0.2"
  },
  "nx": {
    "tags": [
      "type:package",
      "scope:backend"
    ],
    "targets": {
      "typecheck": {
        "command": "node ../../node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
