{
  "name": "@keenko-playground/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./globals.css": "./src/styles/globals.css",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "node ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@keenko-playground/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.2"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "nx": {
    "tags": [
      "type:lib",
      "scope:ui"
    ]
  }
}
