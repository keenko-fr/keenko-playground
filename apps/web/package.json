{
  "name": "@keenko-playground/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "codegen": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale --no-emit-readme && tsr generate",
    "test:auth:e2e": "playwright test --config playwright.config.ts --headed --workers=1"
  },
  "dependencies": {
    "@confect/core": "10.0.0-next.22",
    "@convex-dev/react-query": "0.1.0",
    "@keenko-playground/backend": "workspace:*",
    "@keenko-playground/shared": "workspace:*",
    "@keenko-playground/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.54",
    "@tanstack/react-table": "9.2.4",
    "@workos/authkit-tanstack-react-start": "0.11.1",
    "convex": "1.45.0",
    "effect": "4.0.0-rc.115",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.2",
    "@playwright/test": "1.63.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.36",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "6.0.2",
    "vite": "8.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:web"
    ],
    "targets": {
      "typecheck": {
        "command": "node ../../node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
