{
  "name": "keenko-playground",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "0.38.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-plugin-effect": "0.11.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "ultracite": "7.10.7"
  }
}
